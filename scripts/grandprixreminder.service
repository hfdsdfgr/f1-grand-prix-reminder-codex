[Unit]
Description=GrandPrixReminder FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=grandprix
Group=grandprix
UMask=0077
NoNewPrivileges=true
WorkingDirectory=/opt/grandprixreminder/backend
Environment=DATABASE_PATH=/opt/grandprixreminder/backend/data/schedules.db
EnvironmentFile=/etc/grandprixreminder.env
ExecStart=/opt/grandprixreminder/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
